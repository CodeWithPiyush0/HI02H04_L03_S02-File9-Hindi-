  "audio_text": {
   "vo_box1": "राजा का तुकांत शब्द पहचानिए।",
   "vo_box1_hint2": "रानी, बाजा, मुकुट।",
   "vo_box2": "रात के साथ कौन-सा शब्द तुकांत है?",
   "vo_box2_hint2": "दिन, बात, तारा।",
   "vo_box3": "फूल के साथ कौन-सा शब्द तुकांत है?",
   "vo_box3_hint2": "धूल, पत्ता, पेड़।",
   "vo_box4": "पानी के साथ कौन-सा शब्द तुकांत है?",
   "vo_box4_hint2": "दूध, रानी, गिलास।",
   "vo_box5": "गाना के साथ कौन-सा शब्द तुकांत है?",
   "vo_box5_hint2": "दाना, गीत, ढोल।",
   "vo_box6": "हाथ के साथ कौन-सा शब्द तुकांत है?",
   "vo_box6_hint2": "पैर, नाक, साथ।",
   "vo_box_intro": "डिब्बे को खोलने के लिए उस पर टैप कीजिए।",
   "vo_box_next": "किसी भी एक डिब्बे पर टैप कीजिए।",
   "vo_cel": "शाबाश! आपने तुकांत शब्द पहचानना सीख लिया।",
   "vo_g1_correct": "शाबाश! आपने सभी तुकांत शब्द पहचान लिए।",
   "vo_g1_hint2": "इस शब्द के अंत में आई की आवाज़ नहीं है।",
   "vo_g1_prompt": "इन पंक्तियों में, आई की आवाज़ वाले सभी शब्दों पर टैप कीजिए।",
   "vo_g2_hint1": "शब्दों को बोलकर देखिए। कढ़ाई से मिलती हुई आवाज़ वाला शब्द पहचानिए।",
   "vo_g2_hint2": "नचाई, चूल्हा, जलेबी।",
   "vo_g2_hint3": "कढ़ाई और नचाई दोनों तुकांत शब्द हैं। नचाई शब्द पर टैप कीजिए।",
   "vo_g2_prompt": "कढ़ाई का तुकांत शब्द पहचानिए। नचाई, चूल्हा, जलेबी।",
   "vo_g3_hint1": "शब्दों को बोलकर देखिए। क्या दोनों शब्दों की अंतिम आवाज़ समान है?",
   "vo_g3_hint2": "मिठाई, चूल्हा।",
   "vo_g3_hint3": "मिठाई और चूल्हा दोनों की अंतिम आवाज़ अलग-अलग है। यह तुकांत शब्द नहीं हैं।",
   "vo_g3_prompt": "मिठाई, चूल्हा, क्या यह तुकांत शब्द हैं? हाँ, नहीं।",
   "vo_g4_hint1": "शब्दों को बोलकर देखिए। हलवाई से मिलती हुई आवाज़ वाला शब्द पहचानिए।",
   "vo_g4_hint2": "रजाई, पैसे, जलेबी।",
   "vo_g4_hint3": "हलवाई और रजाई दोनों तुकांत शब्द हैं। रजाई शब्द पर टैप कीजिए।",
   "vo_g4_prompt": "हलवाई का तुकांत शब्द पहचानिए। रजाई, पैसे, जलेबी।",
   "vo_g5_hint1": "शब्दों को बोलकर देखिए। मोर से मिलती हुई आवाज़ वाला शब्द पहचानिए।",
   "vo_g5_hint2": "चोर, शेर, हाथी।",
   "vo_g5_hint3": "मोर और चोर दोनों तुकांत शब्द हैं। चोर शब्द पर टैप कीजिए।",
   "vo_g5_prompt": "अब इस वाक्य को सही तुकांत शब्द चुनकर पूरा कीजिए। जंगल में नाच रहा था मोर। तभी वहाँ आया एक, खाली जगह। चोर, शेर, हाथी।",
   "vo_g6_hint1": "शब्दों को बोलकर देखिए। केला से मिलती हुई आवाज़ वाला शब्द पहचानिए।",
   "vo_g6_hint2": "मेला, पेड़, फूल।",
   "vo_g6_hint3": "केला और मेला दोनों तुकांत शब्द हैं। मेला शब्द पर टैप कीजिए।",
   "vo_g6_prompt": "तुकांत शब्द चुनकर वाक्य पूरा कीजिए। बंदर खा रहा था केला। पास ही लगा था एक, खाली जगह। मेला, पेड़, फूल।",
   "vo_l1": "हलवाई ने आग सुलगाई।",
   "vo_l2": "फिर चूल्हे पर धरी कढ़ाई।",
   "vo_l3": "कढ़ाई में जलेबी नचाई।",
   "vo_l4": "फिर जलेबी को चाशनी पिलाई।",
   "vo_l5": "मुनिया जलेबी देख खिलखिलाई।",
   "vo_l6": "आँख नचाई, लार टपकाई।",
   "vo_l7": "घर से पैसे लेकर आई।",
   "vo_l8": "जी भर कर जलेबी खाई।",
   "vo_landing": "नमस्ते दोस्त, मैं हूँ स्विफ्टी। आज हम एक कविता पढ़ेंगे, जलेबी।",
   "vo_mic_intro": "इस बटन पर टैप कीजिए और कविता पढ़िए।",
